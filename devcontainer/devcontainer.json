{
  "name": "olake-dev",
  "dockerFile": "devcontainer/Dockerfile",
  "context": "..",
  "runArgs": ["--env-file", ".env"],
  "mounts": [
    "source=${localWorkspaceFolder},target=/workspace,type=bind"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
